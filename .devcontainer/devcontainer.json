{
	"name": "Twitch VOD Downloader",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "..",
		"args": {
			"BASE_IMAGE": "ghcr.io/milesburton/twitch-vod-downloader-base:main"
		}
	},
	"forwardPorts": [8080],
	"portsAttributes": {
		"8080": {
			"label": "FileBrowser",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"eamodio.gitlens",
				"ms-python.python",
				"ms-azuretools.vscode-docker",
				"humao.rest-client",
				"redhat.vscode-yaml",
				"mikestead.dotenv",
				"streetsidesoftware.code-spell-checker",
				"prisma.prisma",
				"ms-python.black-formatter",
				"ms-vscode.live-server",
				"ms-vscode-remote.remote-ssh",
				"mechatroner.rainbow-csv",
				"bungcip.better-toml",
				"charliermarsh.ruff",
				"biomejs.biome",
				"wayou.vscode-todo-highlight",
				"formulahendry.auto-close-tag",
				"mongodb.mongodb-vscode",
				"ms-toolsai.jupyter",
				"mtxr.sqltools",
				"alexcvzz.vscode-sqlite",
				"github.copilot",
				"github.copilot-chat",
				"anthropic.claude-code",
				"github.vscode-github-actions",
				"ryanluker.vscode-coverage-gutters"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "fish",
				"editor.formatOnSave": true,
				"editor.tabSize": 2,
				"files.trimTrailingWhitespace": true,
				"js/ts.tsdk.path": "node_modules/typescript/lib"
			}
		}
	},
	"workspaceFolder": "/workspaces/twitch-vod-downloader",
	"remoteUser": "bun",
	"mounts": [
		"source=${localEnv:HOME}/.ssh,target=/home/bun/.ssh,type=bind,readonly",
		{
			"source": "fish_history",
			"target": "/home/bun/.local/share/fish",
			"type": "volume"
		},
		{
			"source": "${localWorkspaceFolder}/shared",
			"target": "/workspace/shared",
			"type": "bind"
		},
		{
			"source": "${localEnv:HOME}/.config/gh",
			"target": "/home/bun/.config/gh",
			"type": "bind"
		},
		{
			"source": "${localEnv:HOME}/.gitconfig",
			"target": "/home/bun/.gitconfig",
			"type": "bind"
		}
	],
	"containerEnv": {
		"GIT_SSH_COMMAND": "ssh -o StrictHostKeyChecking=no"
	},
	"postCreateCommand": "bun install && bun add -g @biomejs/biome",
	"postStartCommand": "nohup filebrowser -a 0.0.0.0 -p 8080 -r /workspace/data > /tmp/filebrowser.log 2>&1 &"
}
